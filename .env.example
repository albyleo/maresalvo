# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional legacy setting; NOT needed for the certification pilot. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma — opzionale se usi solo Supabase)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Earth 3D (Cesium) ---
# Token Cesium ion (gratuito): abilita terreno mondiale e geocoder.
# https://cesium.com/ion/  → senza token il globo usa terreno ellissoidale.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Google Maps Platform — Photorealistic 3D Tiles (vista tipo Google Earth).
# Richiede fatturazione attiva + "Map Tiles API" abilitata.
# Senza chiave la modalità Earth 3D usa il satellite Esri come fallback.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Mappa marina (opzionali) ---
# Terreno 3D del fondale via MapTiler (terrain-RGB):
NEXT_PUBLIC_MAPTILER_KEY=
# Monitoraggio AIS via Global Fishing Watch:
GFW_API_TOKEN=
