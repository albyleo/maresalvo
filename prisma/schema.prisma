generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  regional_committee
  club_instructor
  fisherman
  public_verifier

  @@map("user_role")
}

enum QualificationStatus {
  pending
  active
  expired
  suspended
  revoked

  @@map("qualification_status")
}

enum CertificateStatus {
  draft
  issued
  revoked
  expired

  @@map("certificate_status")
}

enum PermitStatus {
  draft
  submitted
  under_review
  approved
  rejected
  expired
  revoked

  @@map("permit_status")
}

enum PermitType {
  competition
  training
  special_event
  amp_access
  other

  @@map("permit_type")
}

enum AmpAreaType {
  amp
  parco_sommerso
  santuario
  riserva
  zone_informativa

  @@map("amp_area_type")
}

enum AmpFishingStatus {
  allowed
  restricted
  prohibited
  seasonal
  unknown

  @@map("amp_fishing_status")
}

enum GhostNetStatus {
  reported
  verified
  recovery_planned
  recovered
  rejected

  @@map("ghost_net_status")
}

enum GearType {
  net
  longline
  trap
  rope
  other

  @@map("gear_type")
}

enum IllegalReportSource {
  ais_geofence
  citizen
  patrol

  @@map("illegal_report_source")
}

enum IllegalReportStatus {
  open
  under_review
  forwarded
  dismissed

  @@map("illegal_report_status")
}

model Region {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique @db.VarChar(3)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  clubs    Club[]
  profiles Profile[]

  @@map("regions")
}

model Club {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  regionId  String   @map("region_id") @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  city      String?  @db.VarChar(100)
  province  String?  @db.VarChar(5)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  region   Region    @relation(fields: [regionId], references: [id])
  profiles Profile[]

  @@map("clubs")
}

model Profile {
  id              String   @id @db.Uuid
  role            UserRole @default(fisherman)
  clubId          String?  @map("club_id") @db.Uuid
  regionId        String?  @map("region_id") @db.Uuid
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name")
  fiscalCode      String?  @map("fiscal_code") @db.VarChar(16)
  birthDate       DateTime? @map("birth_date") @db.Date
  phone           String?  @db.VarChar(30)
  address         String?
  city            String?  @db.VarChar(100)
  province        String?  @db.VarChar(5)
  postalCode      String?  @map("postal_code") @db.VarChar(10)
  fipsasCardNumber String? @unique @map("fipsas_card_number") @db.VarChar(30)
  avatarUrl       String?  @map("avatar_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  club              Club?                    @relation(fields: [clubId], references: [id])
  region            Region?                  @relation(fields: [regionId], references: [id])
  qualifications    FishermanQualification[]
  medicalCertificates MedicalCertificate[]
  certificates      Certificate[]
  permitRequests    PermitRequest[]
  authorizations    Authorization[]
  notifications     Notification[]

  @@map("profiles")
}

model QualificationLevel {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code            String   @unique @db.VarChar(20)
  name            String   @db.VarChar(100)
  description     String?
  minAge          Int?     @map("min_age")
  validityMonths  Int      @default(24) @map("validity_months")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  qualifications FishermanQualification[]

  @@map("qualification_levels")
}

model FishermanQualification {
  id           String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  profileId    String              @map("profile_id") @db.Uuid
  levelId      String              @map("level_id") @db.Uuid
  status       QualificationStatus @default(pending)
  issuedAt     DateTime?           @map("issued_at") @db.Date
  expiresAt    DateTime?           @map("expires_at") @db.Date
  issuedBy     String?             @map("issued_by") @db.Uuid
  examDate     DateTime?           @map("exam_date") @db.Date
  examLocation String?             @map("exam_location") @db.VarChar(200)
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile      Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  level        QualificationLevel  @relation(fields: [levelId], references: [id])
  certificates Certificate[]

  @@unique([profileId, levelId, issuedAt])
  @@map("fisherman_qualifications")
}

model Certificate {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serialNumber     String            @unique @map("serial_number") @db.VarChar(30)
  verificationCode String            @unique @map("verification_code") @db.VarChar(64)
  profileId        String            @map("profile_id") @db.Uuid
  qualificationId  String?           @map("qualification_id") @db.Uuid
  certificateType  String            @default("qualification") @map("certificate_type") @db.VarChar(50)
  title            String            @db.VarChar(200)
  status           CertificateStatus @default(draft)
  issuedAt         DateTime?         @map("issued_at") @db.Timestamptz
  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz
  issuedBy         String?           @map("issued_by") @db.Uuid
  pdfUrl           String?           @map("pdf_url")
  qrPayload        String            @map("qr_payload")
  metadata         Json              @default("{}")
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz
  revokedReason    String?           @map("revoked_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile       Profile                 @relation(fields: [profileId], references: [id])
  qualification FishermanQualification? @relation(fields: [qualificationId], references: [id])

  @@map("certificates")
}

model PermitRequest {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestNumber String       @unique @map("request_number") @db.VarChar(30)
  profileId     String       @map("profile_id") @db.Uuid
  permitType    PermitType   @map("permit_type")
  status        PermitStatus @default(draft)
  title         String       @db.VarChar(200)
  description   String?
  requestedArea String?      @map("requested_area")
  startDate     DateTime?    @map("start_date") @db.Date
  endDate       DateTime?    @map("end_date") @db.Date
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz
  reviewNotes   String?      @map("review_notes")
  metadata      Json         @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile        Profile         @relation(fields: [profileId], references: [id])
  authorizations Authorization[]

  @@map("permit_requests")
}

model Authorization {
  id                  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  permitRequestId     String       @map("permit_request_id") @db.Uuid
  authorizationNumber String       @unique @map("authorization_number") @db.VarChar(30)
  verificationCode    String       @unique @map("verification_code") @db.VarChar(64)
  profileId           String       @map("profile_id") @db.Uuid
  permitType          PermitType   @map("permit_type")
  title               String       @db.VarChar(200)
  conditions          String?
  validFrom           DateTime     @map("valid_from") @db.Date
  validUntil          DateTime     @map("valid_until") @db.Date
  approvedBy          String?      @map("approved_by") @db.Uuid
  pdfUrl              String?      @map("pdf_url")
  qrPayload           String       @map("qr_payload")
  status              PermitStatus @default(approved)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  permitRequest PermitRequest @relation(fields: [permitRequestId], references: [id])
  profile       Profile       @relation(fields: [profileId], references: [id])

  @@map("authorizations")
}

model MarineProtectedArea {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  externalId      String?          @map("external_id") @db.VarChar(100)
  name            String           @db.VarChar(300)
  slug            String           @unique @db.VarChar(300)
  areaType        AmpAreaType      @default(amp) @map("area_type")
  regionName      String?          @map("region_name") @db.VarChar(100)
  managingBody    String?          @map("managing_body") @db.VarChar(200)
  description     String?
  regulationUrl   String?          @map("regulation_url")
  fishingStatus   AmpFishingStatus @default(unknown) @map("fishing_status")
  fishingNotes    String?          @map("fishing_notes")
  seasonality     String?
  areaKm2         Decimal?         @map("area_km2") @db.Decimal(12, 4)
  properties      Json             @default("{}")
  isActive        Boolean          @default(true) @map("is_active")
  sourceUpdatedAt DateTime?        @map("source_updated_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("marine_protected_areas")
}

model MedicalCertificate {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  doctorName  String?   @map("doctor_name") @db.VarChar(200)
  issuedAt    DateTime  @map("issued_at") @db.Date
  expiresAt   DateTime  @map("expires_at") @db.Date
  documentUrl String?   @map("document_url")
  verifiedBy  String?   @map("verified_by") @db.Uuid
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz
  isValid     Boolean   @default(true) @map("is_valid")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("medical_certificates")
}

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  profileId Str